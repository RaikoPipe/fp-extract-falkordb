# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=factory_planning

# LLM configuration (litellm format)
# For Ollama: ollama/model-name
# For OpenAI: gpt-4o
# For Anthropic: anthropic/claude-sonnet-4-20250514
LLM_MODEL=ollama/qwen3.5:122b-a10b
OLLAMA_API_KEY=ollama
OLLAMA_API_BASE=http://localhost:41434

# Document ingestion
DATA_DIR=./data

# Merge mode: overwrite (last-write-wins) or conflict (first-writer-wins + JSONL log)
# MERGE_MODE=conflict
# CONFLICTS_LOG=./data/conflicts.jsonl

# Reconciliation (similarity-based duplicate detection for plain-name Resources)
# RECON_ENABLE=false
# RECONCILIATIONS_LOG=./data/reconciliations.jsonl
# RECON_COSINE_CUTOFF=0.70
# RECON_CONFIDENCE_THRESHOLD=0.90
# RECON_TOP_K=10

# Embedding model for reconciliation + vector search
# EMBEDDING_MODEL=ollama/bge-m3
# VECTOR_DIM=1024

# LangChain deep-agent harness
# Agent reasoning model (litellm format). Drives the LangChain agent itself,
# distinct from LLM_MODEL which drives entity extraction and NL-to-Cypher.
# Examples: anthropic/claude-sonnet-4-20250514, openai/gpt-4o, ollama/llama3.1
AGENT_LLM_MODEL=ollama/glm-5.2:cloud
