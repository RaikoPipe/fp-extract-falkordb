# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=factory_planning

# LLM configuration (bare Ollama tags, served via Ollama's OpenAI-compatible endpoint)
# Chat completions hit OLLAMA_API_BASE/v1/chat/completions.
# Embeddings hit EMBEDDING_API_BASE/v1/embeddings (local Ollama by default).
LLM_MODEL=qwen3.5:122b-a10b
# OLLAMA_API_KEY is a SECRET — put it in .env.secrets (see .env.secrets.example),
# not here. docker-compose.yml loads it via env_file so values containing $
# or other special chars are not mangled by ${} interpolation.
OLLAMA_API_BASE=http://localhost:41434

# Document ingestion
DATA_DIR=./data
# Originals: raw uploaded/source files (PDF/DOCX/images/etc.) that have NOT
# yet been preprocessed into Markdown. Chainlit uploads land here, and the
# agent's file_metadata / read_excerpt / ls tools inspect this tree.
ORIGINALS_DIR=./data/originals
# Preprocessed: docprep Markdown output. chunk_documents / extract_and_write
# read from here by default, so ingestion only consumes LLM-ready Markdown.
PREPROCESSED_DIR=./data/preprocessed

# Document preprocessing (docprep) — VLM fallback for scanned PDFs / images.
# The [ollama] provider reuses OLLAMA_API_BASE / OLLAMA_API_KEY above; only set
# these if you want to override the fallback config from a docprep.yaml file.
# DOCPREP_FALLBACK_PROVIDER=ollama
# DOCPREP_FALLBACK_MODEL=llama3.2-vision
# DOCPREP_FALLBACK_BASE_URL=http://localhost:11434/v1

# Merge mode: overwrite (last-write-wins) or conflict (first-writer-wins + graph-stored conflict records)
# MERGE_MODE=conflict

# Reconciliation (similarity-based duplicate detection for plain-name Resources)
# RECON_ENABLE=false
# RECONCILIATIONS_LOG=./data/reconciliations.jsonl
# RECON_COSINE_CUTOFF=0.70
# RECON_CONFIDENCE_THRESHOLD=0.90
# RECON_TOP_K=10

# Embedding model for reconciliation + vector search
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_BASE=http://localhost:11434
# VECTOR_DIM=1024

# LangChain deep-agent harness
# Agent reasoning model (bare Ollama tag), drives the LangChain agent itself,
# distinct from LLM_MODEL which drives entity extraction and NL-to-Cypher.
# Examples: anthropic/claude-sonnet-4-20250514, gpt-4o, glm-5.2:cloud
AGENT_LLM_MODEL=glm-5.2:cloud

# --- Authentication & chat persistence -------------------------------------
# CHAINLIT_AUTH_SECRET is a SECRET — put it in .env.secrets (see
# .env.secrets.example), not here. Generate with: chainlit create-secret.
# Required whenever a password_auth_callback is registered.

# Data-layer connection string. SQLite is the zero-ops default; the file
# lives under DATA_DIR (mounted in docker-compose). Switch to a Postgres
# URL (postgresql+asyncpg://...) for multi-host deployments.
DATABASE_URL=sqlite+aiosqlite:///./data/chainlit.db

# Directory where uploaded files attached to persisted threads are stored
# (LocalStorageClient). Defaults to <DATA_DIR>/elements when unset.
# ELEMENTS_DIR=./data/elements

# Set to 1 to allow self-service registration via the /register route.
# When unset, registration is rejected (only pre-existing accounts can log in).
REGISTER_ENABLED=1

# --- Email (SMTP) ----------------------------------------------------------
# Required for email verification, approval notifications, and password
# reset. When SMTP_HOST/SMTP_FROM are unset, emails are skipped (the app
# still runs, but users won't receive verification/reset links — fine for
# local dev, NOT for production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD is a SECRET — put it in .env.secrets.
# SMTP_USE_TLS=1
# SMTP_FROM=noreply@example.com
# Public base URL of the deployed app, used to build absolute links in
# transactional emails. Must match your production origin (HTTPS).
# APP_BASE_URL=https://kg.example.com

# --- First admin bootstrap -------------------------------------------------
# Set all three to create/promote the first admin account at startup
# (idempotent — safe to leave set on every restart). Alternatively use
# `falkordb-agent create-admin --username ... --email ...` from the CLI.
# FIRST_ADMIN_USERNAME=admin
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD is a SECRET — put it in .env.secrets.
