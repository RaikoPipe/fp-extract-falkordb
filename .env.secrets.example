# Secrets for docker-compose — loaded literally via env_file (no ${}
# interpolation), so values may safely contain $, /, @, ?, etc.
#
# Copy this file to .env.secrets and fill in real values. .env.secrets is
# git-ignored (.gitignore excludes .env*) and excluded from the Docker build
# context (.dockerignore excludes .env*).
#
# These vars are NOT listed under `environment:` in docker-compose.yml, so
# they only reach the container via the env_file directive below.

# Chainlit JWT signing secret. Required for password auth. Generate with:
#   chainlit create-secret
CHAINLIT_AUTH_SECRET=

# Ollama API key (used for chat completions +, when EMBEDDING_API_KEY is
# unset, embeddings). May be unused if your Ollama endpoint needs no key.
OLLAMA_API_KEY=

# Embedding API key (sent to EMBEDDING_API_BASE). Defaults to "ollama" when
# unset in the app; set here only if your embedding endpoint requires a key.
EMBEDDING_API_KEY=

# Optional provider keys for non-Ollama LLM providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SMTP password for transactional email (verification / reset / approval).
# Leave empty if your SMTP host requires no auth.
SMTP_PASSWORD=

# Password for the first admin account bootstrapped at startup
# (FIRST_ADMIN_USERNAME / FIRST_ADMIN_EMAIL come from the non-secret .env).
FIRST_ADMIN_PASSWORD=